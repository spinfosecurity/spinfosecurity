                 $ics = $IcsPorts[$port]
                 Write-Finding `
                     -IpAddress $ip -Port $port `
@@ -250,7 +260,7 @@ $exportPaths = Export-ScanReport -Findings @($script:ScanFindings) -OutputDir $O
     -Metadata @{
