@@ -230,7 +237,10 @@ foreach ($ip in $hosts) {
 
         # --- ICS Protocol Checks ---
         foreach ($port in $IcsPorts.Keys) {
-            if (Test-TcpPort -IpAddress $ip -Port $port -TimeoutMilliseconds $TimeoutMs) {
